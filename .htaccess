<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Saubere URLs für Hauptseiten
    RewriteRule ^ueber-mich/?$ src/pages/about.html [L,QSA]
    RewriteRule ^projekte/?$ src/pages/projekte.html [L,QSA]
    RewriteRule ^kontakt/?$ src/pages/contact.html [L,QSA]
    RewriteRule ^datenschutz/?$ src/pages/datenschutz.html [L,QSA]
    RewriteRule ^impressum/?$ src/pages/impressum.html [L,QSA]
    
    # Projekte mit sprechenden URLs
    RewriteRule ^projekte/weserkoje/?$ src/pages/P1_IA_Weserkoje.html [L,QSA]
    RewriteRule ^projekte/schlaf/?$ src/pages/P2_IA_Schlaf.html [L,QSA]
    RewriteRule ^projekte/my-mind-studio/?$ src/pages/P3_IA_MyMindStudio.html [L,QSA]
    RewriteRule ^projekte/kloster-holzen/?$ src/pages/P4_IA_KlosterHolzen.html [L,QSA]
    RewriteRule ^projekte/planora/?$ src/pages/P5_UXUI_Planora.html [L,QSA]
    RewriteRule ^projekte/om-nom-zen/?$ src/pages/P6_UXUI_OmNomZen.html [L,QSA]
    RewriteRule ^projekte/flavor-fusion/?$ src/pages/P7_UXUI_FlavorFusion.html [L,QSA]
    RewriteRule ^projekte/natur-kompass/?$ src/pages/P8_UXUI_NaturKompass.html [L,QSA]
</IfModule>

# Opt-out route to user-facing opt-out page
Redirect 302 /opt-out /opt-out.html
